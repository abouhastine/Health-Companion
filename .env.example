POSTGRES_DB=health_companion
POSTGRES_USER=health_companion
POSTGRES_PASSWORD=health_companion
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:${POSTGRES_PORT}/health_companion
DATABASE_USERNAME=${POSTGRES_USER}
DATABASE_PASSWORD=${POSTGRES_PASSWORD}
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=health-documents
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
JWT_SECRET=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_DOCUMENT_SIZE=10MB
# Keep both as none for a database/UI-only local run. Use the local-ai Spring
# profile, or set both to ollama, when the local models are available.
AI_CHAT_PROVIDER=none
AI_EMBEDDING_PROVIDER=none
AI_TOP_K=4
AI_REQUEST_TIMEOUT=120s
AI_TEMPERATURE=0.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_CONTEXT_SIZE=4096
OLLAMA_KEEP_ALIVE=10m
# Optional OpenAI provider settings (set both providers to openai to use them).
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

POSTGRES_DB=health_companion
POSTGRES_USER=health_companion
POSTGRES_PASSWORD=health_companion
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:${POSTGRES_PORT}/health_companion
DATABASE_USERNAME=${POSTGRES_USER}
DATABASE_PASSWORD=${POSTGRES_PASSWORD}
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=health-documents
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
JWT_SECRET=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_DOCUMENT_SIZE=10MB
# Keep this as none for a database/UI-only local run. Use the local-ai Spring
# profile, or set it to ollama, when the local model is available.
AI_CHAT_PROVIDER=none
AI_REQUEST_TIMEOUT=120s
AI_TEMPERATURE=0.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_CONTEXT_SIZE=4096
OLLAMA_KEEP_ALIVE=10m
# Optional OpenAI provider settings.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
